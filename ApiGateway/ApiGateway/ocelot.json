      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5280
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/auth/me",
      "UpstreamHttpMethod": [ "GET" ],
