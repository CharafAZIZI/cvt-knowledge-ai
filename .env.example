# Copier ce fichier en ".env" puis remplacer TOUTES les valeurs.
# Le fichier .env ne doit JAMAIS être commité.
# Générer un secret :  openssl rand -hex 48

# ---- Environnement ASP.NET Core (Development en local, Production en déploiement)
ASPNETCORE_ENVIRONMENT=Development

# ---- SQL Server (8+ caractères, majuscules + minuscules + chiffres)
MSSQL_SA_PASSWORD=ChangeMe_Str0ngPassword

# ---- JWT (clé >= 32 octets, identique pour AuthService et DocumentService)
JWT_KEY=REPLACE_WITH_openssl_rand_hex_48
JWT_ISSUER=CVTAuthService
JWT_AUDIENCE=CVTAdministration
JWT_EXPIRATION_MINUTES=120

# ---- MinIO
MINIO_ROOT_USER=cvtadmin
MINIO_ROOT_PASSWORD=ChangeMe_MinioPassw0rd
MINIO_BUCKET=cvt-documents

# ---- Service IA
AI_OLLAMA_MODEL=llama3.2:3b
